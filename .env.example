# Скопируйте этот файл в .env и подставьте свои значения.

# Подключение к PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL="postgresql://site_admin:пароль@localhost:5432/football_db?schema=public"

# Секрет для подписи сессионных токенов (любая длинная случайная строка).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="замените-на-случайную-строку"

# Пароль тестовых пользователей, создаваемых командой npm run db:seed
SEED_PASSWORD="football2025"
